{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "public/fraction-world",
  "redirects": [
    {
      "source": "/fraction-world",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/fraction-world/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/fraction-world/:path*",
      "destination": "/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/optimized-v12/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
