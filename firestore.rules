rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isLinkedMember(userId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.authUid == request.auth.uid;
    }

    function canAccessUserScopedData(userId) {
      return isOwner(userId) || isLinkedMember(userId);
    }

    function practiceRecordOwnerFromId(recordId) {
      return recordId.split('__')[0];
    }

    function classroomProgressOwnerFromId(progressId) {
      return progressId.split('__')[0];
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function hasNoForbiddenUserFields(data) {
      return !data.keys().hasAny([
        'password',
        'plainPassword',
        'passwordHash',
        'passwordSalt'
      ]);
    }

    function isActiveStudentUser() {
      return resource.data.role == 'student'
        && resource.data.status == 'active'
        && resource.data.active == true;
    }

    function canReadUserDocument() {
      return isSignedIn()
        && hasNoForbiddenUserFields(resource.data)
        && (
          isAdmin()
          || resource.data.authUid == request.auth.uid
          || isActiveStudentUser()
        );
    }

    function canUpdateOwnUserProfileSettings(userId) {
      return isSignedIn()
        && userId == resource.data.userId
        && canAccessUserScopedData(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'profileImageUrl',
          'profileImageSource',
          'profileImageStoragePath',
          'profileImageScale',
          'profileImageOffsetX',
          'profileImageOffsetY',
          'rankingMessage',
          'selectedTitleId',
          'updatedAt'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileImageUrl']) || request.resource.data.profileImageUrl is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileImageUrl']) || request.resource.data.profileImageUrl.size() <= 1200)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileImageSource']) || request.resource.data.profileImageSource is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileImageSource']) || request.resource.data.profileImageSource in ['', 'candidate', 'upload'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileImageStoragePath']) || request.resource.data.profileImageStoragePath is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileImageStoragePath']) || request.resource.data.profileImageStoragePath.size() <= 500)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileImageScale']) || request.resource.data.profileImageScale is number)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileImageScale']) || (request.resource.data.profileImageScale >= 0.7 && request.resource.data.profileImageScale <= 2.2))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileImageOffsetX']) || request.resource.data.profileImageOffsetX is number)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileImageOffsetX']) || (request.resource.data.profileImageOffsetX >= -45 && request.resource.data.profileImageOffsetX <= 45))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileImageOffsetY']) || request.resource.data.profileImageOffsetY is number)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileImageOffsetY']) || (request.resource.data.profileImageOffsetY >= -45 && request.resource.data.profileImageOffsetY <= 45))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rankingMessage']) || request.resource.data.rankingMessage is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rankingMessage']) || request.resource.data.rankingMessage.size() <= 24)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['selectedTitleId']) || request.resource.data.selectedTitleId is string)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['selectedTitleId'])
          || request.resource.data.selectedTitleId == ''
          || exists(/databases/$(database)/documents/userTitles/$(userId)/titles/$(request.resource.data.selectedTitleId))
        );
    }

    function hasValidPracticeProgressShape(recordId) {
      return isSignedIn()
        && request.resource.data.memberUserId is string
        && canAccessUserScopedData(request.resource.data.memberUserId)
        && (!request.resource.data.keys().hasAny(['authUid']) || request.resource.data.authUid == request.auth.uid)
        && request.resource.data.source == 'firebase-app'
        && request.resource.data.version == 2
        && request.resource.data.recordId is string
        && request.resource.data.recordId == recordId
        && recordId.matches(request.resource.data.memberUserId + '__.*')
        && request.resource.data.userId == request.resource.data.memberUserId
        && request.resource.data.mode == 'practice'
        && request.resource.data.correctCount is number
        && request.resource.data.totalCount is number
        && request.resource.data.starCount is number
        && request.resource.data.correctIds is list
        && request.resource.data.keys().hasOnly([
          'recordId',
          'memberUserId',
          'userId',
          'authUid',
          'quizId',
          'area',
          'detail',
          'areaKey',
          'mode',
          'completionType',
          'inferredCompletionType',
          'totalCount',
          'correctCount',
          'correctIds',
          'starCount',
          'completed',
          'firstCompletedAt',
          'lastCompletedAt',
          'lastAchievedAt',
          'createdAt',
          'updatedAt',
          'source',
          'version',
          'grade',
          'classNo',
          'number',
          'nickname',
          'hasLegacyUnknown',
          'legacyUnknownCount',
          'sourceSheet',
          'sourceRowNumber',
          'mergedSources',
          'migratedAt',
          'migrationSource'
        ]);
    }

    function canCreatePracticeProgress(recordId) {
      return hasValidPracticeProgressShape(recordId);
    }

    function canUpdatePracticeProgress(recordId) {
      return isSignedIn()
        && request.resource.data.memberUserId is string
        && canAccessUserScopedData(request.resource.data.memberUserId)
        && (!request.resource.data.keys().hasAny(['authUid']) || request.resource.data.authUid == request.auth.uid)
        && request.resource.data.source == 'firebase-app'
        && request.resource.data.version == 2
        && request.resource.data.recordId is string
        && request.resource.data.recordId == recordId
        && recordId.matches(request.resource.data.memberUserId + '__.*')
        && request.resource.data.userId == request.resource.data.memberUserId
        && request.resource.data.mode == 'practice'
        && request.resource.data.correctCount is number
        && request.resource.data.totalCount is number
        && request.resource.data.starCount is number
        && request.resource.data.correctIds is list
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'recordId',
          'memberUserId',
          'userId',
          'authUid',
          'quizId',
          'area',
          'detail',
          'areaKey',
          'mode',
          'completionType',
          'inferredCompletionType',
          'totalCount',
          'correctCount',
          'correctIds',
          'starCount',
          'completed',
          'firstCompletedAt',
          'lastCompletedAt',
          'lastAchievedAt',
          'createdAt',
          'updatedAt',
          'source',
          'version'
        ])
        && (!resource.data.keys().hasAny(['memberUserId']) || resource.data.memberUserId == request.resource.data.memberUserId)
        && (!resource.data.keys().hasAny(['userId']) || resource.data.userId == request.resource.data.userId || resource.data.userId == request.resource.data.memberUserId)
        && (!resource.data.keys().hasAny(['recordId']) || resource.data.recordId == request.resource.data.recordId)
        && (!resource.data.keys().hasAny(['areaKey']) || resource.data.areaKey == request.resource.data.areaKey);
    }

    function canReadPracticeProgress(recordId) {
      return isSignedIn()
        && canAccessUserScopedData(practiceRecordOwnerFromId(recordId))
        && recordId.matches(practiceRecordOwnerFromId(recordId) + '__.*')
        && (
          !exists(/databases/$(database)/documents/practiceRecords/$(recordId))
          || (
            (!resource.data.keys().hasAny(['recordId']) || resource.data.recordId == recordId)
            && (
              !resource.data.keys().hasAny(['memberUserId'])
              || resource.data.memberUserId == practiceRecordOwnerFromId(recordId)
            )
            && (
              !resource.data.keys().hasAny(['userId'])
              || resource.data.userId == practiceRecordOwnerFromId(recordId)
            )
          )
        );
    }

    function hasValidPracticeSummaryShape(userId) {
      return isSignedIn()
        && canAccessUserScopedData(userId)
        && request.resource.data.memberUserId == userId
        && request.resource.data.userId == userId
        && request.resource.data.totalStars is number
        && request.resource.data.recordCount is number
        && request.resource.data.groupStars is map
        && request.resource.data.groups is map
        && request.resource.data.keys().hasOnly([
          'userId',
          'memberUserId',
          'totalStars',
          'earnedBadgeCount',
          'groupStars',
          'recommendedBadgeId',
          'recordCount',
          'legacyUnknownRecordCount',
          'groups',
          'migrationSource',
          'migratedAt',
          'updatedAt'
        ]);
    }

    function canUpdatePracticeSummary(userId) {
      return hasValidPracticeSummaryShape(userId)
        && (!resource.data.keys().hasAny(['memberUserId']) || resource.data.memberUserId == request.resource.data.memberUserId)
        && (!resource.data.keys().hasAny(['userId']) || resource.data.userId == request.resource.data.userId || resource.data.userId == request.resource.data.memberUserId);
    }

    function hasValidUserBadgeShape(userId, badgeId) {
      return isSignedIn()
        && canAccessUserScopedData(userId)
        && request.resource.data.memberUserId == userId
        && request.resource.data.userId == userId
        && request.resource.data.badgeId == badgeId
        && request.resource.data.correct is number
        && request.resource.data.total is number
        && request.resource.data.starCount is number
        && request.resource.data.progressPercent is number
        && request.resource.data.keys().hasOnly([
          'userId',
          'memberUserId',
          'badgeId',
          'label',
          'group',
          'areaKey',
          'sourceId',
          'correct',
          'total',
          'starCount',
          'completed',
          'available',
          'progressPercent',
          'hasLegacyUnknown',
          'migrationSource',
          'migratedAt',
          'updatedAt'
        ]);
    }

    function hasValidRankingRecordShape(recordId) {
      return isSignedIn()
        && request.resource.data.memberUserId is string
        && canAccessUserScopedData(request.resource.data.memberUserId)
        && request.resource.data.recordId == recordId
        && recordId.matches('firebase_.*')
        && request.resource.data.userId == request.resource.data.memberUserId
        && request.resource.data.rankingMode in ['normal', 'speed', 'onechance', 'nohint']
        && request.resource.data.legacy == false
        && request.resource.data.hasUserId == true
        && request.resource.data.sourceSheet == 'firebase-app'
        && request.resource.data.score is number
        && request.resource.data.score > 0
        && request.resource.data.elapsedSeconds is number
        && request.resource.data.elapsedSeconds > 0
        && request.resource.data.elapsedSeconds <= 1200
        && request.resource.data.keys().hasOnly([
          'recordId',
          'memberUserId',
          'userId',
          'displayName',
          'grade',
          'classNo',
          'number',
          'profileImageUrl',
          'rankingMessage',
          'selectedTitleId',
          'quizId',
          'category',
          'categoryKey',
          'rawCategory',
          'subFilter',
          'score',
          'elapsedSeconds',
          'elapsedText',
          'rankingMode',
          'sourceSheet',
          'sourceRowNumber',
          'legacy',
          'hasUserId',
          'recordedAt',
          'createdAt',
          'updatedAt',
          'migrationSource',
          'migratedAt'
        ]);
    }

    function hasValidUserRankingSummaryShape(userId) {
      return isSignedIn()
        && canAccessUserScopedData(userId)
        && request.resource.data.memberUserId == userId
        && request.resource.data.userId == userId
        && request.resource.data.hasUserId == true
        && request.resource.data.totalRecordCount is number
        && request.resource.data.legacyRecordCount is number
        && request.resource.data.byMode is map
        && request.resource.data.bestScoresByMode is map
        && request.resource.data.keys().hasOnly([
          'memberUserId',
          'userId',
          'displayName',
          'hasUserId',
          'totalRecordCount',
          'legacyRecordCount',
          'byMode',
          'bestScoresByMode',
          'migrationSource',
          'migratedAt',
          'updatedAt'
        ]);
    }

    function canUpdateUserRankingSummary(userId) {
      return hasValidUserRankingSummaryShape(userId)
        && resource.data.memberUserId == request.resource.data.memberUserId
        && resource.data.userId == request.resource.data.userId;
    }

    function hasValidQuizKingSummaryShape(userId) {
      return isSignedIn()
        && canAccessUserScopedData(userId)
        && request.resource.data.memberUserId == userId
        && request.resource.data.userId == userId
        && request.resource.data.hasUserId == true
        && request.resource.data.categories is list
        && request.resource.data.totalScore is number
        && request.resource.data.categoryCount is number
        && request.resource.data.rank is number
        && request.resource.data.keys().hasOnly([
          'memberUserId',
          'userId',
          'displayName',
          'hasUserId',
          'categories',
          'totalScore',
          'categoryCount',
          'rank',
          'migrationSource',
          'migratedAt',
          'updatedAt'
        ]);
    }

    function canUpdateQuizKingSummary(userId) {
      return hasValidQuizKingSummaryShape(userId)
        && resource.data.memberUserId == request.resource.data.memberUserId
        && resource.data.userId == request.resource.data.userId;
    }

    function hasValidClassroomQuestProgressBaseShape(classId, progressId) {
      return isSignedIn()
        && request.resource.data.recordId == progressId
        && request.resource.data.classId == classId
        && request.resource.data.memberUserId is string
        && request.resource.data.memberUserId == classroomProgressOwnerFromId(progressId)
        && canAccessUserScopedData(request.resource.data.memberUserId)
        && request.resource.data.userId == request.resource.data.memberUserId
        && request.resource.data.questId is string
        && request.resource.data.questType is string
        && request.resource.data.checked is bool
        && request.resource.data.checked == true
        && request.resource.data.status == 'student_checked'
        && request.resource.data.rewardCoin is number
        && (!request.resource.data.keys().hasAny(['rewardCurrency']) || request.resource.data.rewardCurrency == 'berry')
        && request.resource.data.rewardStatus in ['pending_teacher_review', 'approved', 'rejected']
        && request.resource.data.source == 'firebase-app'
        && request.resource.data.version == 1
        && (!request.resource.data.keys().hasAny(['reviewedBy']) || request.resource.data.reviewedBy is string)
        && request.resource.data.keys().hasOnly([
          'recordId',
          'classId',
          'questId',
          'questType',
          'memberUserId',
          'userId',
          'checked',
          'status',
          'rewardCoin',
          'rewardCurrency',
          'rewardStatus',
          'reviewedBy',
          'reviewedAt',
          'source',
          'version',
          'createdAt',
          'updatedAt'
        ]);
    }

    function canCreateClassroomQuestProgress(classId, progressId) {
      return hasValidClassroomQuestProgressBaseShape(classId, progressId)
        && request.resource.data.rewardStatus == 'pending_teacher_review'
        && !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt']);
    }

    function canUpdateClassroomQuestProgress(classId, progressId) {
      return hasValidClassroomQuestProgressBaseShape(classId, progressId)
        && request.resource.data.rewardStatus == 'pending_teacher_review'
        && resource.data.recordId == request.resource.data.recordId
        && resource.data.classId == request.resource.data.classId
        && resource.data.memberUserId == request.resource.data.memberUserId
        && resource.data.userId == request.resource.data.userId
        && resource.data.questId == request.resource.data.questId;
    }

    function canReviewClassroomQuestProgress(classId, progressId) {
      return isAdmin()
        && hasValidClassroomQuestProgressBaseShape(classId, progressId)
        && resource.data.recordId == request.resource.data.recordId
        && resource.data.classId == request.resource.data.classId
        && resource.data.memberUserId == request.resource.data.memberUserId
        && resource.data.userId == request.resource.data.userId
        && resource.data.questId == request.resource.data.questId
        && resource.data.rewardStatus == 'pending_teacher_review'
        && request.resource.data.rewardStatus in ['approved', 'rejected']
        && request.resource.data.reviewedBy is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rewardStatus',
          'reviewedBy',
          'reviewedAt',
          'updatedAt'
        ]);
    }

    match /shopItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assetCatalog/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /quizQuestions/{quizId}/questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow get: if canReadUserDocument();
      allow list: if isSignedIn()
        && hasNoForbiddenUserFields(resource.data)
        && resource.data.authUid == request.auth.uid;
      allow update: if isAdmin() || canUpdateOwnUserProfileSettings(userId);
      allow create, delete: if isAdmin();
    }

    match /memberCredentials/{userId} {
      allow read, write: if false;
    }

    match /memberPasswordSetupState/{userId} {
      allow read, write: if false;
    }

    match /memberPasswordSetupSessions/{sessionId} {
      allow read, write: if false;
    }

    match /memberAuthLogs/{logId} {
      allow read, write: if false;
    }

    match /authSettings/{settingId} {
      allow read, write: if false;
    }

    match /appSettings/{settingId} {
      allow read: if settingId in ['featureFlags', 'externalQuizzes'] && isSignedIn();
      allow write: if isAdmin();
    }

    match /userEconomy/{userId} {
      allow read: if canAccessUserScopedData(userId);
      allow write: if isAdmin();
    }

    match /userInventory/{userId}/{document=**} {
      allow read: if canAccessUserScopedData(userId);
      allow write: if isAdmin();
    }

    match /userRoomSettings/{userId} {
      allow read, write: if canAccessUserScopedData(userId);
    }

    match /dailyUsage/{recordId} {
      allow read: if isSignedIn()
        && recordId.matches('.*__.*')
        && canAccessUserScopedData(recordId.split('__')[0]);
      allow create, update: if false;
      allow delete: if false;
    }

    match /purchaseLogs/{logId} {
      allow read: if false;
      allow write: if isAdmin();
    }

    match /practiceRecords/{recordId} {
      allow read: if canReadPracticeProgress(recordId);
      allow create: if canCreatePracticeProgress(recordId);
      allow update: if canUpdatePracticeProgress(recordId);
      allow delete: if false;
    }

    match /userPracticeSummary/{userId} {
      allow read: if canAccessUserScopedData(userId);
      allow create: if hasValidPracticeSummaryShape(userId);
      allow update: if canUpdatePracticeSummary(userId);
      allow delete: if false;
    }

    match /userBadges/{userId}/badges/{badgeId} {
      allow read: if canAccessUserScopedData(userId);
      allow create, update: if hasValidUserBadgeShape(userId, badgeId);
      allow delete: if false;
    }

    match /userTitles/{userId}/titles/{titleId} {
      allow read: if canAccessUserScopedData(userId);
      allow write: if isAdmin();
    }

    match /userTitleSummary/{userId} {
      allow read: if canAccessUserScopedData(userId);
      allow write: if isAdmin();
    }

    match /titleCatalog/{titleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /profileImageCandidates/{candidateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /noticeBoard/{noticeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /classrooms/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /questProgress/{progressId} {
        allow read: if isSignedIn()
          && (isAdmin() || canAccessUserScopedData(classroomProgressOwnerFromId(progressId)));
        allow create: if canCreateClassroomQuestProgress(classId, progressId);
        allow update: if canUpdateClassroomQuestProgress(classId, progressId)
          || canReviewClassroomQuestProgress(classId, progressId);
        allow delete: if false;
      }

      match /studentWallets/{userId} {
        allow read: if isSignedIn() && (isAdmin() || canAccessUserScopedData(userId));
        allow write: if false;
      }

      match /berryLogs/{logId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      match /studentGemProgress/{progressId} {
        allow read: if isSignedIn()
          && (
            isAdmin()
            || canAccessUserScopedData(classroomProgressOwnerFromId(progressId))
            || (resource.data.memberUserId is string && canAccessUserScopedData(resource.data.memberUserId))
          );
        allow write: if false;
      }
    }

    match /rankingRecords/{recordId} {
      allow read: if isSignedIn();
      allow create: if hasValidRankingRecordShape(recordId);
      allow update, delete: if false;
    }

    match /userRankingSummary/{userId} {
      allow read: if canAccessUserScopedData(userId);
      allow create: if hasValidUserRankingSummaryShape(userId);
      allow update: if canUpdateUserRankingSummary(userId);
      allow delete: if false;
    }

    match /quizKingSummary/{userId} {
      allow read: if isSignedIn();
      allow create: if hasValidQuizKingSummaryShape(userId);
      allow update: if canUpdateQuizKingSummary(userId);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
